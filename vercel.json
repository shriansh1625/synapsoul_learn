{
  "buildCommand": "npm install --prefix tutor && npm run build --prefix tutor",
  "outputDirectory": "tutor/dist",
  "headers": [
    {
      "source": "/skill.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" }
      ]
    },
    {
      "source": "/install",
      "headers": [
        { "key": "Content-Type", "value": "text/x-shellscript; charset=utf-8" },
        { "key": "Content-Disposition", "value": "inline; filename=\"install.sh\"" }
      ]
    },
    {
      "source": "/install.ps1",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/cli/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/gzip" }
      ]
    },
    {
      "source": "/learnlab-kit.zip",
      "headers": [
        { "key": "Content-Type", "value": "application/zip" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"learnlab-kit.zip\"" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.svg" },
    { "source": "/u/:username", "destination": "/index.html" },
    { "source": "/auth/callback", "destination": "/index.html" },
    { "source": "/college", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/((?!privacy(?:/|$)|policy\\.css$|assets/|cli/|learnlab-kit\\.zip|skill\\.md|PROMPT\\.md|install$|install\\.ps1|favicon).*)", "destination": "/index.html" }
  ]
}
