{
  "buildCommand": "npm install --prefix tutor && npm run build --prefix tutor",
  "outputDirectory": "tutor/dist",
  "headers": [
    {
      "source": "/learnlab-kit.zip",
      "headers": [
        { "key": "Content-Type", "value": "application/zip" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"learnlab-kit.zip\"" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.svg" },
    { "source": "/u/:username", "destination": "/index.html" },
    { "source": "/auth/callback", "destination": "/index.html" },
    { "source": "/college", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/((?!assets/|learnlab-kit\\.zip|skill\\.md|PROMPT\\.md|favicon).*)", "destination": "/index.html" }
  ]
}
