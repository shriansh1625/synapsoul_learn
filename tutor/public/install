#!/bin/sh
# SynapSoul Learn Hub CLI installer — downloads the student CLI only. Does not clone a repo.
set -e

ORIGIN="${SYNAPSOUL_ORIGIN:-${LEARNLAB_ORIGIN:-https://synapsoullearn.runs-on.dev}}"
API="${SYNAPSOUL_API_URL:-${LEARNLAB_API_URL:-https://learnerslab.onrender.com}}"
SITE="${SYNAPSOUL_SITE:-${LEARNLAB_SITE:-https://synapsoullearn.runs-on.dev}}"

if [ -n "${SYNAPSOUL_HOME:-}" ]; then
  HOME_DIR="$SYNAPSOUL_HOME"
elif [ -n "${LEARNLAB_HOME:-}" ]; then
  HOME_DIR="$LEARNLAB_HOME"
elif [ -d "$HOME/.synapsoul" ]; then
  HOME_DIR="$HOME/.synapsoul"
elif [ -d "$HOME/.learnlab" ]; then
  HOME_DIR="$HOME/.learnlab"
else
  HOME_DIR="$HOME/.synapsoul"
fi

TARBALL_URL="${ORIGIN%/}/cli/learnlab-cli.tar.gz"

echo "SynapSoul Learn Hub installer"
echo "  CLI home: $HOME_DIR"
echo "  API:      $API"

if ! command -v node >/dev/null 2>&1; then
  echo "SynapSoul needs Node.js 18 or newer."
  echo "Install it from https://nodejs.org then re-run:"
  echo "  curl -fsSL ${ORIGIN%/}/install | sh"
  exit 1
fi

NODE_MAJOR=$(node -p "process.versions.node.split('.')[0]" 2>/dev/null || echo 0)
if [ "$NODE_MAJOR" -lt 18 ]; then
  echo "Node.js 18+ required (found $(node -v))."
  exit 1
fi

if ! command -v tar >/dev/null 2>&1; then
  echo "This installer needs tar."
  exit 1
fi

mkdir -p "$HOME_DIR"
TMPDIR=$(mktemp -d 2>/dev/null || mktemp -d -t synapsoul)
trap 'rm -rf "$TMPDIR"' EXIT

echo "Downloading CLI from $TARBALL_URL"
if command -v curl >/dev/null 2>&1; then
  curl -fsSL "$TARBALL_URL" -o "$TMPDIR/cli.tar.gz"
elif command -v wget >/dev/null 2>&1; then
  wget -qO "$TMPDIR/cli.tar.gz" "$TARBALL_URL"
else
  echo "Need curl or wget to download the CLI."
  exit 1
fi

# Keep session/auth across reinstalls
tar -xzf "$TMPDIR/cli.tar.gz" -C "$HOME_DIR"

mkdir -p "$HOME_DIR/bin"
cat > "$HOME_DIR/config.json" <<EOF
{
  "standalone": true,
  "apiUrl": "$API",
  "siteUrl": "$SITE",
  "origin": "$ORIGIN",
  "installedAt": "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
}
EOF

cat > "$HOME_DIR/bin/synapsoul" <<EOF
#!/bin/sh
ROOT="\${SYNAPSOUL_HOME:-\${LEARNLAB_HOME:-$HOME_DIR}}"
if [ -z "\$SYNAPSOUL_API_URL" ] && [ -z "\$LEARNLAB_API_URL" ]; then
  SYNAPSOUL_API_URL="$API"
  export SYNAPSOUL_API_URL
fi
if [ -z "\$LEARNLAB_API_URL" ] && [ -n "\$SYNAPSOUL_API_URL" ]; then
  LEARNLAB_API_URL="\$SYNAPSOUL_API_URL"
  export LEARNLAB_API_URL
fi
exec node "\$ROOT/cli/index.mjs" "\$@"
EOF
chmod +x "$HOME_DIR/bin/synapsoul"
cp "$HOME_DIR/bin/synapsoul" "$HOME_DIR/bin/learnlab"
chmod +x "$HOME_DIR/bin/learnlab"

LOCAL_BIN="$HOME/.local/bin"
mkdir -p "$LOCAL_BIN"
ln -sf "$HOME_DIR/bin/synapsoul" "$LOCAL_BIN/synapsoul"
ln -sf "$HOME_DIR/bin/learnlab" "$LOCAL_BIN/learnlab"

on_path() {
  echo ":$PATH:" | grep -q ":$LOCAL_BIN:"
}

append_rc() {
  rc="$1"
  line='export PATH="$HOME/.local/bin:$PATH"'
  if [ -f "$rc" ] && grep -qs '.local/bin' "$rc"; then
    return
  fi
  if [ -f "$rc" ] || [ -w "$(dirname "$rc")" ]; then
    printf '\n# SynapSoul CLI\n%s\n' "$line" >> "$rc"
    echo "Added ~/.local/bin to PATH in $rc"
  fi
}

if ! on_path; then
  append_rc "$HOME/.bashrc"
  append_rc "$HOME/.zshrc"
  append_rc "$HOME/.profile"
  echo "Restart your shell (or run: export PATH=\"\$HOME/.local/bin:\$PATH\") so synapsoul is on PATH."
fi

echo
echo "Installed. FIRST: register or login (do not start lessons until the CLI has a JWT)."
echo "  synapsoul register --email you@college.edu --password YOUR_PASSWORD --name \"Your Name\""
echo "  synapsoul login --email you@college.edu --password YOUR_PASSWORD"
echo "  synapsoul login --github"
echo "Or register at $SITE then synapsoul login --email …"
echo
echo "Then:"
echo "  synapsoul start"
echo
echo "Protocol: ${SITE%/}/skill.md"
