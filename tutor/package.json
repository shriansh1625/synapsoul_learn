{
  "name": "ai-tutor",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "bin": {
    "synapsoul": "./cli/index.mjs",
    "learnlab": "./cli/index.mjs",
    "tutor": "./cli/index.mjs"
  },
  "scripts": {
    "kit": "node scripts/build-student-kit.mjs",
    "cli-bundle": "node scripts/build-cli-bundle.mjs",
    "prebuild": "node scripts/build-cli-bundle.mjs && node scripts/build-student-kit.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tutor": "node cli/index.mjs",
    "synapsoul": "node cli/index.mjs",
    "learnlab": "node cli/index.mjs",
    "tutor:status": "node cli/index.mjs status --json",
    "tutor:catalog": "node cli/index.mjs catalog --json",
    "tutor:start": "node cli/index.mjs start --json",
    "test:live:api": "node scripts/live-test.mjs",
    "playwright:install": "playwright install chromium",
    "pretest:live:e2e": "npm run playwright:install",
    "test:live:e2e": "playwright test e2e/live-journey.spec.js",
    "test:live": "npm run test:live:api && npm run test:live:e2e"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  }
}
