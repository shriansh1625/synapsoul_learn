DATABASE_URL=postgresql://user:pass@host:5432/learnlab
JWT_SECRET=change-me-to-a-long-random-string
# Vercel URL for CORS (no trailing slash; comma-separate multiple origins)
FRONTEND_URL=https://tutor-alpha-sandy.vercel.app
PORT=3001
# Optional — heuristic coach always works without these
# Set LEARNLAB_LLM_ENABLED=false to force heuristics only
LEARNLAB_LLM_ENABLED=true
# Groq is preferred when GROQ_API_KEY is set (OpenAI-compatible API)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub OAuth (optional — buttons show a setup state if unset; never commit secrets)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://learnerslab.onrender.com/api/auth/github/callback

# LinkedIn OAuth (optional — pasted LinkedIn URLs always work without this)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=https://learnerslab.onrender.com/api/auth/linkedin/callback

# Single-admin lock (server only — never put these in VITE_* or the frontend)
# Only this email can be admin. Register with your own password; do not invent one.
ADMIN_EMAIL=omshriansh16@gmail.com
GMAIL_USER=omshriansh16@gmail.com
# Google App Password (not your Gmail login). Never commit this.
# 16 characters, no spaces. Google displays groups of 4; strip the spaces.
# Google Account → Security → 2-Step Verification → App passwords
# Production: set this on Render learnlab-api (learnerslab.onrender.com), not Vercel.
GMAIL_APP_PASSWORD=
